# Sao chép thành .env rồi điền giá trị thật. Backend tự đọc file .env (spring.config.import).

# Backend
DB_URL=jdbc:mysql://mysql:3306/toeic_learning?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
RESET_CODE_SECRET=replace-with-a-separate-random-secret
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
EXPOSE_RESET_TOKEN=false
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=/data/uploads

# Email đặt lại mật khẩu: để trống khi chưa cấu hình SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Có thể điền tài khoản nhận tiền dev trong trang Cài đặt thanh toán sau khi khởi động.
PAYMENT_BANK_BIN=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=

# Frontend
VITE_API_URL=http://localhost:8080/api
