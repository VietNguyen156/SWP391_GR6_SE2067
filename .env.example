# Sao chép thành .env rồi điền giá trị thật. Backend tự đọc file .env (spring.config.import).

# Backend
DB_URL=jdbc:mysql://localhost:3306/toeic_learning?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your-db-password
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
EXPOSE_RESET_TOKEN=false
FRONTEND_ORIGIN=http://localhost:5173
# Giữ cùng một thư mục qua các lần chạy, kể cả khi tài khoản hệ điều hành thay đổi.
# UPLOAD_DIR=C:/path/to/persistent/toeic-path-data/uploads

# Tài khoản nhận tiền mặc định (chỉ dùng để tạo dòng payment_settings đầu tiên khi bảng còn trống;
# sau đó admin sửa trong trang Cài đặt thanh toán). Giá trị dưới đây là MẪU, không phải tài khoản thật.
# BIN theo chuẩn VietQR (970436 = Vietcombank), số tài khoản 6–19 chữ số, tên chủ TK in hoa không dấu.
PAYMENT_BANK_BIN=970436
PAYMENT_BANK_NAME=Vietcombank
PAYMENT_ACCOUNT_NO=0123456789
PAYMENT_ACCOUNT_NAME=NGUYEN VAN A

# Frontend
VITE_API_URL=http://localhost:8080/api
